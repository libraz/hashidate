node_modules/
dist/
coverage/
*.tsbuildinfo
.DS_Store
*.log

# The speech sidecar's Python environment. Several GB once torch is in it, and
# rebuilt by `make tts-setup`.
.venv/
__pycache__/

# Purchased assets, extracted intermediates and internal specs. Never tracked.
backup/

# Reference material for the voice lives in tools/tts/reference/ and is governed
# by its own .gitignore there rather than from here. The directory itself is
# tracked, so a checkout arrives with somewhere to put clips; nothing that lands
# in it ever is.

# The documents the character presents from. Somebody else's slides, usually,
# and large either way. Served from here by the control server; see --slides.
#
# Anchored, and it has to be: unanchored it also swallows `src/viewer/scene/
# slides/`, which is source, and a source file that cannot be staged is a file
# that quietly does not exist for anybody who clones this.
/slides/
*.pdf

# Build output of the model pipeline. Regenerated by `make glb`.
public/models/

# Belt and braces: the asset formats this project deals in are all large, and a
# path-based rule only helps for paths anyone thought of.
*.glb
*.gltf
*.fbx
*.unitypackage
*.blend
*.blend1
*.psd
*.vrm
*.zip

.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# AI agents
.claude
CLAUDE.md
AGENT.md
AGENTS.md
