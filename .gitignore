node_modules/
dist/
coverage/
*.tsbuildinfo
.DS_Store
*.log

# The speech sidecar's Python environment. Several GB once torch is in it, and
# rebuilt by `make tts-setup`.
.venv/
__pycache__/

# Purchased assets, extracted intermediates and internal specs. Never tracked.
backup/

# Reference material for the voice lives in tools/tts/reference/ and is governed
# by its own .gitignore there rather than from here. The directory itself is
# tracked, so a checkout arrives with somewhere to put clips; nothing that lands
# in it ever is.

# What an operator brings to a broadcast — decks, scripts, motions — lives under
# `show/`, and each of those directories carries its own .gitignore saying what
# it holds and why none of it is tracked. Nothing about them is stated from here.
#
# The exception is the format rather than the path. A PDF is large wherever it
# lands, and this catches the one saved somewhere nobody wrote a rule for.
*.pdf

# Build output of the model pipeline. Regenerated by `make glb`.
public/models/

# Belt and braces: the asset formats this project deals in are all large, and a
# path-based rule only helps for paths anyone thought of.
*.glb
*.gltf
*.fbx
*.unitypackage
*.blend
*.blend1
*.psd
*.vrm
*.zip

.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# AI agents
.claude
CLAUDE.md
AGENT.md
AGENTS.md
