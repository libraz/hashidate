{
  "name": "hashidate",
  "version": "0.7.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n viewer,control -c cyan,magenta \"vite\" \"tsx watch src/server/main.ts\"",
    "dev:viewer": "vite",
    "dev:control": "tsx watch src/server/main.ts",
    "build": "vite build",
    "shell": "yarn build && NODE_OPTIONS=--import=tsx electron src/shell/main.ts",
    "start": "tsx src/server/main.ts --root dist",
    "ctl": "tsx src/cli/main.ts",
    "mcp": "tsx src/mcp/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-jp": "^5.3.0",
    "@libraz/libsonare": "1.8.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "electron": "^44.5.1",
    "happy-dom": "^20.14.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
