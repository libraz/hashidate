  "script": [
    {
      "emotion": {
        "joy": 0.55,
        "relaxed": 0.45
      },
      "gesture": "wave",
      "text": "こんばんは、マヌカです。今日はよろしくね。"
    },
    {
      "emotion": {
        "relaxed": 0.8
      },
      "gesture": "explain",
      "text": "わたしはARKitのブレンドシェイプを持っていません。"
    },
    {
      "emotion": {
        "thinking": 0.9
      },
      "gesture": "think",
      "text": "だから表情は、目と眉と口を別々に組み合わせて作っています。"
    },
    {
      "emotion": {
        "surprise": 0.85
      },
      "gesture": "pointUp",
      "text": "あっ、それでもちゃんと笑えますよ。"
    },
    {
      "emotion": {
        "joy": 0.9
      },
      "gesture": "present",
      "text": "ほら、こんなふうに。"
    },
    {
      "emotion": {
        "shy": 0.7
      },
      "gesture": "cover",
      "text": "……あんまり見られると照れます。"
    },
    {
      "emotion": {
        "joy": 0.4,
        "relaxed": 0.6
      },
      "gesture": "bow",
      "text": "というわけで、今日はここまで。またね。"
    }
  ]
}
